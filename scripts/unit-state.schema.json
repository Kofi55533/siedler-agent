{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "siedler-agent/unit-state.schema.json",
 "title": "Persistent work unit, attempt and decision records (STRATEGY_20261020 s3.2, s5.5)",
 "type": "object",
 "required": ["units"],
 "properties": {
  "units": {"type": "object", "additionalProperties": {"$ref": "#/$defs/unit"}},
  "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
  "decision": {"$ref": "#/$defs/decision"}
 },
 "$defs": {
  "state": {"enum": ["Discovered", "NeedsContract", "Ready", "Running", "LocalVerified", "GateQueued", "Deferred",
                     "IntegratedPartial", "Resize", "Complete"]},
  "outcome": {"enum": ["ACCEPTED_CODE", "ACCEPTED_PROOF", "NEW_CAUSAL_FINDING", "EQUIVALENCE_PROVED", "DUPLICATE",
                       "NO_PROGRESS", "REGRESSION", "CONFLICT", "INFRA_ERROR", "PROVIDER_BLOCKED"]},
  "unit": {
   "type": "object",
   "required": ["id", "domain", "state"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "domain": {"type": "string", "pattern": "^DS[0-9]{2}$"},
    "parent": {"type": ["string", "null"]},
    "goal": {"type": "string"},
    "state": {"$ref": "#/$defs/state"},
    "branch_epoch": {"type": "integer", "minimum": 1},
    "branch": {"type": "string", "pattern": "^agent/unit-[a-z0-9-]+-e[0-9]{2}$"},
    "head_sha": {"type": ["string", "null"]},
    "pr": {"type": ["integer", "null"]},
    "native_count": {"type": "integer"},
    "write_items": {"type": "array", "items": {"type": "string"}},
    "dependency_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "substantive_attempts": {"type": "integer", "minimum": 0},
    "infra_attempts": {"type": "integer", "minimum": 0},
    "last_gain": {"type": ["string", "null"]},
    "last_served": {"type": ["string", "null"]},
    "last_checkpoint": {"type": ["string", "null"]},
    "blocked_by": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "priority_inputs": {"type": "object"}
   }
  },
  "attempt": {
   "type": "object",
   "required": ["id", "unit_id", "start"],
   "properties": {
    "id": {"type": "string"}, "unit_id": {"type": "string"}, "run_id": {"type": ["integer", "null"]},
    "input_shas": {"type": "object"}, "start": {"type": "string"}, "end": {"type": ["string", "null"]},
    "typed_outcome": {"$ref": "#/$defs/outcome"}, "gate_verdict": {"enum": ["PASS", "FAIL", "DEFERRED", null]},
    "next_action": {"type": ["string", "null"]}
   }
  },
  "decision": {
   "type": "object",
   "required": ["at", "mode", "budget", "chosen"],
   "properties": {
    "at": {"type": "string"}, "mode": {"enum": ["shadow", "live"]},
    "budget": {"type": "integer"}, "exploration_slots": {"type": "integer"},
    "chosen": {"type": "array", "items": {"type": "object", "required": ["unit", "domain", "score", "why"]}},
    "current": {"type": "object"}, "comparison": {"type": "object"}, "challengers": {"type": "object"}
   }
  }
 }
}
